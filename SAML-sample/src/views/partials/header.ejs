<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'SAML-sample' %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
  <style>
    .badge { display:inline-block; padding:.1rem .5rem; border-radius:.25rem; font-size:.8rem; }
    .badge-ok { background:#d1fadf; color:#027a48; }
    .badge-warn { background:#fef0c7; color:#b54708; }
    .copy-row { display:flex; gap:.5rem; align-items:center; margin:.25rem 0; }
    .copy-row code { flex:1; overflow:auto; padding:.25rem .5rem; }
    .copy-row button { white-space:nowrap; padding:.25rem .75rem; }
    .muted { color:var(--pico-muted-color); font-size:.9rem; }
    .mapping-table input { width:100%; }
    .mapping-table td { vertical-align:middle; padding:.25rem; }
    nav.top { display:flex; justify-content:space-between; align-items:center; padding:.5rem 0; border-bottom:1px solid var(--pico-muted-border-color); margin-bottom:1.5rem; }
    nav.top a { margin-right:1rem; }
    fieldset { border:1px solid var(--pico-muted-border-color); border-radius:.5rem; padding:1rem; margin-bottom:1rem; }
    fieldset legend { padding:0 .5rem; font-weight:600; }
  </style>
</head>
<body>
<main class="container">
  <nav class="top">
    <div>
      <strong>SAML-sample</strong>
      <% if (typeof navLabel !== 'undefined' && navLabel) { %><span class="muted"> · <%= navLabel %></span><% } %>
    </div>
    <div>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <span class="muted"><%= currentUser.email %></span>
        <form method="post" action="/logout" style="display:inline; margin-left:.5rem;">
          <button type="submit" class="secondary outline" style="padding:.25rem .75rem;">Log out</button>
        </form>
      <% } %>
    </div>
  </nav>
