# LangGraph Engine Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Choose which LLM provider to use: openai, anthropic, ollama, or litellm
LLM_PROVIDER=openai

# ----------------------------------------------------------------------------
# OpenAI Configuration (if using LLM_PROVIDER=openai)
# ----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
# Model options: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
OPENAI_MODEL=gpt-4

# ----------------------------------------------------------------------------
# Anthropic Configuration (if using LLM_PROVIDER=anthropic)
# ----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Model options: claude-3-5-sonnet-20241022, claude-3-opus-20240229, claude-3-sonnet-20240229
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ----------------------------------------------------------------------------
# Ollama Configuration (if using LLM_PROVIDER=ollama)
# ----------------------------------------------------------------------------
# Ollama runs locally, no API key needed
# Make sure Ollama is installed and running: https://ollama.ai
OLLAMA_BASE_URL=http://localhost:11434
# Model options: llama2, codellama, mistral, phi, etc.
# List available models: ollama list
OLLAMA_MODEL=codellama

# ----------------------------------------------------------------------------
# LiteLLM Configuration (if using LLM_PROVIDER=litellm)
# ----------------------------------------------------------------------------
# LiteLLM provides unified access to 100+ LLM providers
# Get started: https://docs.litellm.ai/docs/
LITELLM_API_KEY=your-litellm-api-key-here
# Model format: provider/model-name
# Examples:
#   gpt-4                              (OpenAI)
#   claude-3-5-sonnet-20241022         (Anthropic)
#   azure/gpt-4                        (Azure OpenAI)
#   bedrock/anthropic.claude-3-5-sonnet-20240620-v1:0  (AWS Bedrock)
#   gemini/gemini-pro                  (Google Gemini)
#   ollama/codellama                   (Local Ollama)
LITELLM_MODEL=gpt-4

# Optional: LiteLLM base URL (if using custom proxy)
# LITELLM_BASE_URL=http://localhost:4000

# ----------------------------------------------------------------------------
# AWS Bedrock Configuration (when using LLM_PROVIDER=litellm with Bedrock)
# ----------------------------------------------------------------------------
# AWS Bedrock Long-Term API Keys (Service-Specific Credentials)
# These are BEDROCK-SPECIFIC credentials, NOT standard IAM access keys
#
# How to generate:
#   Method 1: AWS Console → Amazon Bedrock → API keys → Create long-term API key
#   Method 2: IAM Console → Users → Security credentials → Service-specific credentials
#
# Learn more: https://docs.aws.amazon.com/IAM/latest/UserGuide/id_credentials_bedrock.html
#
# Security Note: These credentials are limited to Bedrock operations only (more secure than full IAM keys)
# Expiration options: 1, 5, 30, 90, 365 days, custom, or never expires
# Recommendation: Use short-term keys (12 hours) or rotate long-term keys regularly

# Your Bedrock service-specific credentials:
AWS_ACCESS_KEY_ID=your-bedrock-api-key-id-here
AWS_SECRET_ACCESS_KEY=your-bedrock-secret-api-key-here
AWS_REGION_NAME=us-east-1

# Example Bedrock Configuration with SSO Profile:
# -------------------------------------------------
# LLM_PROVIDER=litellm
# LITELLM_MODEL=bedrock/us.anthropic.claude-3-5-sonnet-v2:0
# AWS_REGION_NAME=us-east-1
# AWS_PROFILE=your-sso-profile-name
#
# Before starting the server, login to AWS SSO:
#   aws sso login --profile your-sso-profile-name
#
# Example Bedrock Configuration with Access Keys (not recommended):
# -------------------------------------------------------------------
# LLM_PROVIDER=litellm
# LITELLM_MODEL=bedrock/us.anthropic.claude-3-5-sonnet-v2:0
# AWS_ACCESS_KEY_ID=ASIABEDROCK123EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_REGION_NAME=us-east-1
#
# Available Bedrock Models (use cross-region inference profiles):
# ----------------------------------------------------------------
# Claude 3.5 Models:
# - bedrock/us.anthropic.claude-3-5-sonnet-v2:0        (Latest Sonnet, best for code)
# - bedrock/us.anthropic.claude-3-5-haiku-v1:0         (Fast and efficient)
#
# Claude 3 Models (legacy, use direct model IDs):
# - bedrock/anthropic.claude-3-5-sonnet-20240620-v1:0  (Legacy Sonnet)
# - bedrock/anthropic.claude-3-opus-20240229-v1:0      (Legacy Opus)
# - bedrock/anthropic.claude-3-sonnet-20240229-v1:0    (Legacy Sonnet)
# - bedrock/anthropic.claude-3-haiku-20240307-v1:0     (Legacy Haiku)
#
# Claude 4 Models (use cross-region inference profiles):
# - bedrock/us.anthropic.claude-opus-4-5-v1:0          (Most capable, requires inference profile)
#
# Other Providers:
# - bedrock/amazon.titan-text-express-v1               (Amazon Titan)
# - bedrock/ai21.j2-ultra-v1                           (AI21 Jurassic)
# - bedrock/meta.llama2-70b-chat-v1                    (Meta Llama)
#
# IMPORTANT NOTES:
# ----------------
# 1. Newer models (Claude 4.x, Claude 3.5 v2) require inference profile ARNs
# 2. Inference profiles use format: us.anthropic.model-name (cross-region)
# 3. DO NOT set LITELLM_API_KEY when using Bedrock
# 4. Bedrock uses AWS credentials (Profile, Access Keys, or EC2 Instance Role)

# ============================================================================
# Server Configuration
# ============================================================================
# Port where the FastAPI server will run
SERVER_PORT=8000

# Host address (use 127.0.0.1 for local only, 0.0.0.0 for network access)
SERVER_HOST=127.0.0.1

# ============================================================================
# Generation Settings
# ============================================================================
# Maximum tokens to use for examples (to fit within LLM context window)
MAX_EXAMPLES_TOKENS=6000

# Temperature for LLM (0.0 = deterministic, 1.0 = creative)
# Lower values (0.2-0.3) are better for code generation
LLM_TEMPERATURE=0.2

# Path to code examples library (relative to langgraph-engine directory)
# The LLM will learn patterns from these example files
EXAMPLES_PATH=../code-gen-source-samples


