# LangGraph Engine Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Choose which LLM provider to use: openai, anthropic, ollama, or litellm
LLM_PROVIDER=openai

# ----------------------------------------------------------------------------
# OpenAI Configuration (if using LLM_PROVIDER=openai)
# ----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
# Model options: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
OPENAI_MODEL=gpt-4

# ----------------------------------------------------------------------------
# Anthropic Configuration (if using LLM_PROVIDER=anthropic)
# ----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Model options: claude-3-5-sonnet-20241022, claude-3-opus-20240229, claude-3-sonnet-20240229
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ----------------------------------------------------------------------------
# Ollama Configuration (if using LLM_PROVIDER=ollama)
# ----------------------------------------------------------------------------
# Ollama runs locally, no API key needed
# Make sure Ollama is installed and running: https://ollama.ai
OLLAMA_BASE_URL=http://localhost:11434
# Model options: llama2, codellama, mistral, phi, etc.
# List available models: ollama list
OLLAMA_MODEL=codellama

# ----------------------------------------------------------------------------
# LiteLLM Configuration (if using LLM_PROVIDER=litellm)
# ----------------------------------------------------------------------------
# LiteLLM provides unified access to 100+ LLM providers
# Get started: https://docs.litellm.ai/docs/
LITELLM_API_KEY=your-litellm-api-key-here
# Model format: provider/model-name
# Examples:
#   gpt-4                              (OpenAI)
#   claude-3-5-sonnet-20241022         (Anthropic)
#   azure/gpt-4                        (Azure OpenAI)
#   bedrock/anthropic.claude-3-5-sonnet-20240620-v1:0  (AWS Bedrock)
#   gemini/gemini-pro                  (Google Gemini)
#   ollama/codellama                   (Local Ollama)
LITELLM_MODEL=gpt-4

# Optional: LiteLLM base URL (if using custom proxy)
# LITELLM_BASE_URL=http://localhost:4000

# ============================================================================
# Server Configuration
# ============================================================================
# Port where the FastAPI server will run
SERVER_PORT=8000

# Host address (use 127.0.0.1 for local only, 0.0.0.0 for network access)
SERVER_HOST=127.0.0.1

# ============================================================================
# Generation Settings
# ============================================================================
# Maximum tokens to use for examples (to fit within LLM context window)
MAX_EXAMPLES_TOKENS=6000

# Temperature for LLM (0.0 = deterministic, 1.0 = creative)
# Lower values (0.2-0.3) are better for code generation
LLM_TEMPERATURE=0.2

# Path to code examples library (relative to langgraph-engine directory)
# The LLM will learn patterns from these example files
EXAMPLES_PATH=../code-gen-source-samples
