<!DOCTYPE html>
<html>
<head>
    <title>Vue Widget in ASP.NET</title>
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    <script src="/js/hello-directive.umd.js"></script> <!--manually copied from client app-->
</head>
<body>
    <div id="vue-root">
        <hello id="demo-01"></hello>
        <hello id="demo-02"></hello>
    </div>

    <script>
        const { createApp } = Vue;
        const app = createApp({});
        app.use(HelloDirective); // HelloDirective is the global from your UMD build
        app.mount("#vue-root");
    </script>
</body>
</html>
