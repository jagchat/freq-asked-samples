{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DeploymentId": "2025-04-01.0001", //TODO: CI/CD. Optional.  Use this to check container refresh through "status" request
  "Serilog": {
    "Properties": {
      "Application": "demo.web.api",
      "EnvironmentName": "Development"
    },
    "MinimumLevel": {
      "Default": "Verbose", //Verbose, Debug, Information, Warning, Error, Fatal
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
      }
    },
    "Using": [
      "Serilog.Enrichers.ClientInfo",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Process",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.HttpContext"
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithClientIp",
      "WithProcessId",
      "WithThreadId",
      "WithExceptionDetails",
      "WithRequestBody",
      "WithRequestQuery",
      {
        "Name": "WithRequestHeader",
        "Args": { "headerName": "User-Agent" }
      },
      {
        "Name": "WithCorrelationId",
        "Args": {
          "headerName": "x-correlation-id",
          "addValueIfHeaderAbsence": true
        }
      }
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3} {Message}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}  [{Level:u3}] {Message} {CorrelationId} {Properties} {NewLine}{Exception}"
        }
      }
      //},
      //{
      //  "Name": "Seq",
      //  "Args": {
      //    "serverUrl": "http://localhost:5341"
      //  }
      //}
    ]
  },
  "AllowedHosts": "*"
}
